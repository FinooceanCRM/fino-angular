APP_NAME=FINOOCEAN
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

FRONTEND_URL=http://localhost:4200

# Signup OTP kill switch for the Vendor/Banker/Connector self-service signup
# pages — TEMPORARY: set to false in production while DLT/MSG91 approval is
# pending (see config/vendors.php, config/bankers.php, config/connectors.php
# `otp_required`). While false, those accounts activate immediately on
# signup instead of waiting on a phone OTP nothing can deliver yet. Flip
# back to true (the default) once MSG91_OTP_TEMPLATE_ID is approved — no
# code changes needed, just this env var + `php artisan config:cache`.
SIGNUP_OTP_REQUIRED=true

# Affiliate program — flat commission rate (percentage, not a fraction:
# 1.00 means 1%) used whenever an affiliate has no commission_rate of their
# own set. See config/affiliates.php.
AFFILIATE_DEFAULT_COMMISSION_RATE=1.00

# Connector referral network — flat commission rate (percentage) used
# whenever a connector has no commission_rate of their own set, and the
# override rate applied at every ancestor level in the referral chain
# (each level earns this percentage of the level below it, geometrically
# decaying). See config/connectors.php.
CONNECTOR_DEFAULT_COMMISSION_RATE=20.00
CONNECTOR_REFERRAL_OVERRIDE_RATE=20.00

# hCaptcha secret key for the public referral lead form
# (POST /public/leads — see CaptchaVerificationService). Get a real key at
# https://dashboard.hcaptcha.com/. Leaving this blank makes every
# submission fail captcha verification, not bypass it.
CAPTCHA_SECRET_KEY=

# Firebase Cloud Messaging — native-app push notifications. Leave both blank
# to disable push (in-app notifications keep working). FCM_CREDENTIALS is an
# absolute path to the service-account JSON key from the Firebase console.
FCM_PROJECT_ID=
FCM_CREDENTIALS=

# MSG91 — delivers the signup OTP (Vendor/Banker/Connector) by SMS. Leave
# both blank to disable delivery; the OTP is still generated/stored/verified
# as normal, it just won't be texted (see Msg91OtpService). MSG91_AUTH_KEY
# comes from the MSG91 dashboard's API auth key screen. MSG91_OTP_TEMPLATE_ID
# is the DLT-approved OTP template's ID from MSG91 > SendOTP > Templates.
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=

LOG_CHANNEL=stack
LOG_LEVEL=debug

# XAMPP / MySQL defaults on Windows
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=finoocean
DB_USERNAME=root
DB_PASSWORD=

# Token-based auth only; sessions are unused by the API.
SESSION_DRIVER=file
SESSION_LIFETIME=120
QUEUE_CONNECTION=sync
CACHE_STORE=file
FILESYSTEM_DISK=local
